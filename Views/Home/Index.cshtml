@{
    ViewData["Title"] = "Trang chủ";
}

<section class="dashboard-hero mb-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <span class="dashboard-eyebrow">
                <i class="bi bi-grid-1x2-fill me-2" aria-hidden="true"></i>BẢNG ĐIỀU KHIỂN
            </span>
            <h1 class="display-6 fw-bold mt-3 mb-2">Chào mừng đến với DemoMVC</h1>
            <p class="mb-0 dashboard-hero-copy">
                Truy cập nhanh các công cụ quản lý dữ liệu, môn học và phân quyền trong hệ thống.
            </p>
        </div>
        <div class="col-lg-4 d-none d-lg-flex justify-content-center">
            <div class="dashboard-hero-icon" aria-hidden="true">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
        </div>
    </div>
</section>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h2 class="h4 mb-1">Lối tắt chức năng</h2>
        <p class="text-muted mb-0">Chọn một chức năng để bắt đầu.</p>
    </div>
</div>

<div class="row g-4 pb-4">
    <div class="col-12 col-md-6 col-xl-4">
        <a class="dashboard-card-link" asp-controller="Quanlysinhvien" asp-action="Index">
            <article class="card dashboard-card h-100">
                <div class="card-body">
                    <span class="dashboard-card-icon icon-blue"><i class="bi bi-people-fill" aria-hidden="true"></i></span>
                    <h3 class="h5 mt-3">Quản lý Sinh viên</h3>
                    <p class="text-muted mb-0">Xem, tìm kiếm và quản lý thông tin sinh viên.</p>
                </div>
                <div class="card-footer">Mở chức năng <i class="bi bi-arrow-up-right ms-1" aria-hidden="true"></i></div>
            </article>
        </a>
    </div>

    <div class="col-12 col-md-6 col-xl-4">
        <a class="dashboard-card-link" asp-controller="Quanlymonhoc" asp-action="Index">
            <article class="card dashboard-card h-100">
                <div class="card-body">
                    <span class="dashboard-card-icon icon-teal"><i class="bi bi-journal-bookmark-fill" aria-hidden="true"></i></span>
                    <h3 class="h5 mt-3">Quản lý Môn học</h3>
                    <p class="text-muted mb-0">Theo dõi danh mục môn học và thông tin tín chỉ.</p>
                </div>
                <div class="card-footer">Mở chức năng <i class="bi bi-arrow-up-right ms-1" aria-hidden="true"></i></div>
            </article>
        </a>
    </div>

    <div class="col-12 col-md-6 col-xl-4">
        <a class="dashboard-card-link" asp-controller="Role" asp-action="Index">
            <article class="card dashboard-card h-100">
                <div class="card-body">
                    <span class="dashboard-card-icon icon-violet"><i class="bi bi-person-badge-fill" aria-hidden="true"></i></span>
                    <h3 class="h5 mt-3">Quản lý Role</h3>
                    <p class="text-muted mb-0">Tạo và quản lý các vai trò trong hệ thống.</p>
                </div>
                <div class="card-footer">Mở chức năng <i class="bi bi-arrow-up-right ms-1" aria-hidden="true"></i></div>
            </article>
        </a>
    </div>

    <div class="col-12 col-md-6 col-xl-4">
        <a class="dashboard-card-link" asp-controller="UserRole" asp-action="Index">
            <article class="card dashboard-card h-100">
                <div class="card-body">
                    <span class="dashboard-card-icon icon-orange"><i class="bi bi-person-lock" aria-hidden="true"></i></span>
                    <h3 class="h5 mt-3">Phân quyền người dùng</h3>
                    <p class="text-muted mb-0">Gán vai trò phù hợp cho từng tài khoản người dùng.</p>
                </div>
                <div class="card-footer">Mở chức năng <i class="bi bi-arrow-up-right ms-1" aria-hidden="true"></i></div>
            </article>
        </a>
    </div>

    <div class="col-12 col-md-6 col-xl-4">
        <a class="dashboard-card-link" asp-controller="ExcelImport" asp-action="Index">
            <article class="card dashboard-card h-100">
                <div class="card-body">
                    <span class="dashboard-card-icon icon-green"><i class="bi bi-file-earmark-spreadsheet-fill" aria-hidden="true"></i></span>
                    <h3 class="h5 mt-3">Nhập dữ liệu Excel</h3>
                    <p class="text-muted mb-0">Tải template và nhập dữ liệu cho các bảng nghiệp vụ.</p>
                </div>
                <div class="card-footer">Mở chức năng <i class="bi bi-arrow-up-right ms-1" aria-hidden="true"></i></div>
            </article>
        </a>
    </div>
</div>