@model IReadOnlyList<string>

@{
    ViewData["Title"] = "Nhập dữ liệu Excel";
}

<div class="container py-4 bg-light rounded-3">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-3 p-lg-4">
    <div class="mb-4">
        <h1 class="h3 mb-1"><i class="bi bi-file-earmark-spreadsheet-fill text-primary me-2" aria-hidden="true"></i>Nhập dữ liệu Excel</h1>
        <p class="text-muted mb-0">Tải tệp mẫu hoặc nhập dữ liệu vào bảng nghiệp vụ.</p>
    </div>

    <div id="excelImportNotification" class="alert d-none mb-3" role="status" aria-live="polite"></div>

            <form id="excelUploadForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-lg-8">
                        <label for="tableName" class="form-label">Bảng dữ liệu cần nhập</label>
                        <select class="form-select" id="tableName" name="tableName" required>
                            <option value="">-- Chọn bảng nghiệp vụ --</option>
                            @foreach (var tableName in Model)
                            {
                                <option value="@tableName">@tableName</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-lg-4 d-grid">
                        <button type="button" class="btn btn-outline-primary btn-sm" id="downloadTemplateButton" disabled>
                            <i class="bi bi-download me-1" aria-hidden="true"></i>Tải tệp Excel mẫu (.xlsx)
                        </button>
                    </div>
                    <div class="col-12">
                        <span class="form-label d-block">Tệp Excel</span>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="chooseExcelFileButton">
                                <i class="bi bi-folder2-open me-1" aria-hidden="true"></i>Chọn tệp Excel
                            </button>
                            <span id="selectedFileName" class="text-muted">Chưa chọn tệp</span>
                        </div>
                        <input class="visually-hidden" type="file" id="file" name="file"
                               accept=".xlsx" aria-label="Chọn tệp Excel" />
                        <div class="form-text">Chỉ chấp nhận tệp có định dạng .xlsx.</div>
                    </div>
                </div>

                <fieldset class="mt-4">
                    <legend class="fs-6 fw-semibold">Chế độ nhập</legend>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="importMode"
                               id="appendMode" value="append" checked />
                        <label class="form-check-label" for="appendMode">
                            <span class="fw-semibold">Ghi bổ sung dữ liệu</span>
                            <span class="text-muted"> (Giữ dữ liệu cũ, chỉ thêm bản ghi mới)</span>
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="importMode"
                               id="overwriteMode" value="overwrite" />
                        <label class="form-check-label text-danger" for="overwriteMode">
                            <span class="fw-semibold">Ghi đè dữ liệu</span>
                            <span> (Xóa toàn bộ dữ liệu cũ của bảng và thay bằng dữ liệu mới)</span>
                        </label>
                    </div>
                </fieldset>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-primary btn-sm" id="uploadExcelButton"
                            disabled="@(Model.Count == 0)">
                        <i class="bi bi-upload me-1" aria-hidden="true"></i>Nhập dữ liệu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="overwriteConfirmationModal" tabindex="-1"
     aria-labelledby="overwriteConfirmationTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger">
            <div class="modal-header bg-danger text-white">
                <h2 class="modal-title fs-5" id="overwriteConfirmationTitle">Cảnh báo ghi đè dữ liệu</h2>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger mb-0" role="alert">
                    Toàn bộ dữ liệu hiện có trong bảng đã chọn sẽ bị xóa và thay thế bằng dữ liệu từ tệp.
                    Thao tác này không thể hoàn tác. Bạn có chắc chắn muốn tiếp tục?
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1" aria-hidden="true"></i>Hủy
                </button>
                <button type="button" class="btn btn-danger" id="confirmOverwriteButton">
                    <i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>Xác nhận ghi đè
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            const form = $('#excelUploadForm')[0];
            const token = $('input[name="__RequestVerificationToken"]').val();
            const templateUrl = '@Url.Action("DownloadTemplate", "ExcelImport")';
            const overwriteModal = new bootstrap.Modal(
                document.getElementById('overwriteConfirmationModal'));
            let uploadInProgress = false;

            function getErrorMessage(xhr) {
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    return xhr.responseJSON.message;
                }

                if (xhr.status === 401) {
                    return 'Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.';
                }

                if (xhr.status === 403) {
                    return 'Bạn không có quyền thực hiện thao tác này.';
                }

                return 'Đã xảy ra lỗi khi nhập dữ liệu.';
            }

            function showResult(message, success) {
                $('#excelImportNotification')
                    .toggleClass('alert-success', success)
                    .toggleClass('alert-danger', !success)
                    .text(message)
                    .removeClass('d-none');
            }

            function uploadFile() {
                if (uploadInProgress) {
                    return;
                }

                uploadInProgress = true;
                const $submitButton = $('#uploadExcelButton').prop('disabled', true);
                const $confirmButton = $('#confirmOverwriteButton').prop('disabled', true);
                $('#excelImportNotification').addClass('d-none').empty();

                $.ajax({
                    url: '@Url.Action("Upload", "ExcelImport")',
                    method: 'POST',
                    data: new FormData(form),
                    processData: false,
                    contentType: false,
                    dataType: 'json',
                    headers: { RequestVerificationToken: token }
                })
                    .done(function (result) {
                        showResult(result.message, result.success);
                        if (result.success) {
                            $('#file').val('');
                            $('#selectedFileName').text('Chưa chọn tệp');
                        }
                    })
                    .fail(function (xhr) {
                        showResult(getErrorMessage(xhr), false);
                    })
                    .always(function () {
                        uploadInProgress = false;
                        $submitButton.prop('disabled', false);
                        $confirmButton.prop('disabled', false);
                    });
            }

            $('#excelUploadForm').on('submit', function (event) {
                event.preventDefault();
                if (!$('#file')[0].files || $('#file')[0].files.length === 0) {
                    showResult('Vui lòng chọn tệp Excel để nhập.', false);
                    return;
                }

                if (!form.checkValidity()) {
                    form.reportValidity();
                    return;
                }

                if ($('input[name="importMode"]:checked').val() === 'overwrite') {
                    overwriteModal.show();
                    return;
                }

                uploadFile();
            });

            $('#confirmOverwriteButton').on('click', function () {
                overwriteModal.hide();
                uploadFile();
            });

            $('#downloadTemplateButton').on('click', function () {
                const tableName = $('#tableName').val();
                if (tableName) {
                    window.location.href = templateUrl + '?tableName=' + encodeURIComponent(tableName);
                }
            });

            $('#tableName').on('change', function () {
                $('#downloadTemplateButton').prop('disabled', !this.value);
            });

            $('#chooseExcelFileButton').on('click', function () {
                $('#file').trigger('click');
            });
            $('#file').on('change', function () {
                $('#selectedFileName').text(
                    this.files && this.files.length > 0 ? this.files[0].name : 'Chưa chọn tệp'
                );
            });
        });
    </script>
}
