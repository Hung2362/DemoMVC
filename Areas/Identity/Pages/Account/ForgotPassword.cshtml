@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="auth-page">
    <div class="row justify-content-center w-100">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
            <section class="card auth-card border-0 shadow-lg">
                <div class="card-body p-4 p-md-5">
                    <div class="auth-heading text-center mb-4">
                        <span class="auth-icon"><i class="bi bi-key-fill" aria-hidden="true"></i></span>
                        <h1 class="h3 mt-3 mb-2">@ViewData["Title"]</h1>
                        <p class="text-muted mb-0">Nhập email đã đăng ký để nhận hướng dẫn đặt lại mật khẩu.</p>
                    </div>
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <div class="form-floating mb-4">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username"
                                   aria-required="true" placeholder="ten@vidu.vn" />
                            <label asp-for="Input.Email">Địa chỉ email</label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="w-100 btn btn-primary btn-lg">
                            <i class="bi bi-envelope-arrow-up-fill me-2" aria-hidden="true"></i>Gửi hướng dẫn
                        </button>
                        <p class="text-center mt-4 mb-0">
                            <a asp-page="./Login" class="text-decoration-none">
                                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Quay lại đăng nhập
                            </a>
                        </p>
                    </form>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
