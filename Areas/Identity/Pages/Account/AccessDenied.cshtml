@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="auth-page">
    <div class="row justify-content-center w-100">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
            <section class="card auth-card border-0 shadow-lg">
                <div class="card-body p-4 p-md-5 text-center">
                    <span class="auth-icon auth-icon-danger">
                        <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
                    </span>
                    <h1 class="h3 text-danger mt-3 mb-2">@ViewData["Title"]</h1>
                    <p class="text-muted mb-4">Tài khoản của bạn không được phép truy cập trang này.</p>
                    <a asp-page="/Account/Login" asp-area="Identity" class="btn btn-primary">
                        <i class="bi bi-box-arrow-in-right me-2" aria-hidden="true"></i>Đăng nhập bằng tài khoản khác
                    </a>
                </div>
            </section>
        </div>
    </div>
</div>
